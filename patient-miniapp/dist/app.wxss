page{background:#f4f7fb;color:#17233d;font-family:PingFang SC,Helvetica Neue,sans-serif;height:100%}.page-shell{background:linear-gradient(180deg,rgba(251,253,255,.98),rgba(244,247,251,.98));height:100vh;overflow:hidden;position:relative}.page-shell-nav{backdrop-filter:blur(36rpx);background:rgba(248,250,253,.94);border-bottom:2rpx solid rgba(214,222,233,.84);box-shadow:none;left:0;position:absolute;right:0;top:0;z-index:30}.page-shell-status-spacer{width:100%}.page-shell-nav-bar{align-items:center;box-sizing:border-box;display:flex;justify-content:center;padding:0 64rpx;position:relative}.page-shell-nav-title{color:#17233d;font-size:64rpx;font-weight:600;letter-spacing:.02em;line-height:1.3;max-width:60%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.page-shell-nav-back{align-items:center;border-radius:1998rpx;color:#17233d;display:flex;height:128rpx;justify-content:center;left:48rpx;position:absolute;top:50%;transform:translateY(-50%);width:128rpx;z-index:2}.page-shell-nav-back-icon{color:inherit;display:block;font-size:108rpx;font-weight:300;line-height:1;margin-top:-8rpx}.page-shell-nav-placeholder{background:hsla(0,0%,100%,.92);border:2rpx solid rgba(214,222,233,.84);border-radius:1998rpx;box-sizing:border-box;position:absolute;right:48rpx;top:50%;transform:translateY(-50%)}.page-shell-body{box-sizing:border-box;height:100%;position:relative}.page-shell-scroll{box-sizing:border-box;height:100%;overflow-y:auto;padding:20rpx 20rpx calc(env(safe-area-inset-bottom) + 192rpx)}.page-shell-overlay{inset:0;position:absolute;z-index:22}.page-shell-bottom{background:linear-gradient(180deg,rgba(244,247,251,0),rgba(244,247,251,.96) 28%);bottom:0;box-sizing:border-box;left:0;padding:20rpx 20rpx calc(env(safe-area-inset-bottom) + 20rpx);position:absolute;right:0;z-index:25}.page-shell-empty-state{background:hsla(0,0%,100%,.72);border:2rpx solid rgba(214,222,233,.7);border-radius:56rpx;box-shadow:0 36rpx 80rpx rgba(31,47,77,.08);box-sizing:border-box;min-height:480rpx;padding:80rpx 64rpx}.page-shell-empty-title{color:#17233d;display:block;font-size:72rpx;font-weight:600;line-height:1.25;margin-bottom:24rpx}.page-shell-empty-text{color:#52627a;display:block;font-size:56rpx;line-height:1.7}.page-container{display:flex;flex-direction:column;gap:40rpx;min-height:100%}.page-section-row{display:flex;gap:40rpx}.page-bottom-dock,.page-section,.page-section-cell{background:hsla(0,0%,100%,.78);border:2rpx solid rgba(214,222,233,.78);border-radius:56rpx;box-shadow:0 32rpx 72rpx rgba(31,47,77,.06);box-sizing:border-box;overflow:hidden;position:relative}.page-bottom-dock::after,.page-section-cell::after,.page-section::after{background:linear-gradient(135deg,hsla(0,0%,100%,.34),rgba(31,111,235,.03));content:"";inset:0;pointer-events:none;position:absolute}.page-section{min-height:360rpx}.page-section-cell{flex:1;min-height:360rpx}.page-bottom-dock{min-height:176rpx}