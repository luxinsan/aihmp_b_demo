.home-page{min-height:2rpx}.home-page-floating-filter{align-items:flex-start;display:flex;flex-direction:column;gap:16rpx;margin-bottom:24rpx}.home-page-team-switch{align-items:center;box-sizing:border-box;display:inline-flex;gap:12rpx;max-width:480rpx;opacity:.78;padding:8rpx 0}.home-page-team-switch-label{color:#17233d;font-size:24rpx;font-weight:500;line-height:1.35;max-width:480rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.home-page-team-switch-icon{color:#74839a;font-size:22rpx;line-height:1}.home-page-team-sheet-list{display:flex;flex-direction:column;gap:20rpx}.home-page-team-sheet-item{align-items:center;background:rgba(246,249,253,.98);border:2rpx solid rgba(214,222,233,.78);border-radius:24rpx;box-sizing:border-box;display:flex;justify-content:space-between;min-height:112rpx;padding:0 24rpx}.home-page-team-sheet-item.is-active{background:linear-gradient(135deg,rgba(31,111,235,.12),rgba(31,111,235,.04));border-color:rgba(31,111,235,.28)}.home-page-team-sheet-item-label{color:#17233d;font-size:26rpx;font-weight:500;line-height:1.35}.home-page-team-sheet-item-check{color:#1f6feb;font-size:34rpx;font-weight:700;line-height:1}.home-page-patient-chip-list{display:flex;gap:20rpx;overflow-x:auto;padding-bottom:4rpx;white-space:nowrap;width:100%}.home-page-ai-assistant{border-radius:36rpx;box-shadow:0 20rpx 56rpx rgba(31,47,77,.08);margin-top:8rpx}.home-page-ai-assistant-badge{align-items:center;background:linear-gradient(135deg,#1f6feb,#7db4ff);border-radius:16rpx;color:#fff;display:flex;flex-shrink:0;font-size:20rpx;font-weight:700;height:44rpx;justify-content:center;line-height:1;width:44rpx}.home-page-ai-assistant-inline{align-items:center;display:flex;gap:16rpx;margin-bottom:20rpx}.home-page-ai-assistant-title{color:#74839a;font-size:22rpx;font-weight:500;line-height:1.35}.home-page-ai-assistant-input{background:rgba(248,250,253,.98);border:2rpx solid rgba(214,222,233,.78);border-radius:36rpx;box-sizing:border-box;display:flex;flex-direction:column;min-height:144rpx;padding:24rpx 32rpx}.home-page-ai-assistant-row{align-items:center;display:flex;gap:24rpx;justify-content:space-between}.home-page-ai-assistant-placeholder{color:#8a96aa;font-size:24rpx;line-height:1.55}.home-page-ai-assistant-send{align-items:center;background:rgba(31,111,235,.1);border-radius:1998rpx;color:#1f6feb;display:flex;flex-shrink:0;font-size:28rpx;font-weight:700;height:56rpx;justify-content:center;line-height:1;width:56rpx}.home-page-service-section{margin-top:20rpx}.home-page-service-grid{display:grid;gap:20rpx;grid-template-columns:repeat(4,minmax(0,1fr))}.home-page-service-item{align-items:center;display:flex;flex-direction:column;gap:16rpx}.home-page-service-icon{align-items:center;background:linear-gradient(135deg,rgba(31,111,235,.12),rgba(125,180,255,.16));border-radius:24rpx;color:#1f6feb;display:flex;font-size:28rpx;font-weight:700;height:80rpx;justify-content:center;line-height:1;width:80rpx}.home-page-service-name{color:#52627a;font-size:22rpx;line-height:1.35;text-align:center}.home-page-data-section{margin-top:20rpx}.home-page-data-grid{display:grid;gap:16rpx;grid-template-columns:repeat(3,minmax(0,1fr))}.home-page-data-patient-list{margin-bottom:0;margin-top:20rpx}.home-page-task-section{margin-top:20rpx}.home-page-task-list{display:flex;flex-direction:column;gap:20rpx}